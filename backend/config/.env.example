# Copy this file to ".env" (same folder) and fill in real values for local dev.
# NEVER commit the real ".env" file - it's already in .gitignore.

DB_HOST=your-service-name.example.com
DB_PORT=3306
DB_USER=example-user
DB_PASSWORD=example-password
DB_NAME=example-db

# Path to the CA cert, if required. Download it from your database console and
# save it as backend/config/ca.pem - a relative path here is resolved against
# that folder.
DB_SSL_CA_PATH=ca.pem

# Used for Flask's session signing. Any random string works locally; set a
# real random value for production.
FLASK_SECRET_KEY=dev
