# Copy this file to ".env" (same folder) and fill in real values for local dev.
# Get these from the Aiven Console -> your MySQL service -> Overview -> Quick connect.
# On Render, set these as real environment variables instead (see README).
# NEVER commit the real ".env" file - it's already in .gitignore.

DB_HOST=your-service-name.aivencloud.com
DB_PORT=12691
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=uof_project

# Path to the Aiven CA cert. Locally, download it from the Aiven Console and
# save it as backend/config/ca.pem - a relative path here is resolved against
# that folder. On Render, set this to the absolute path of a mounted Secret
# File instead, e.g. /etc/secrets/ca.pem.
DB_SSL_CA_PATH=ca.pem

# Used for Flask's session signing. Any random string works locally; set a
# real random value in Render's dashboard for production.
FLASK_SECRET_KEY=dev
